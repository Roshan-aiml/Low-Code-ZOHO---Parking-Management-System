 application "Parking Slot Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Parking_Slot
		{
			displayname = "Parking Slot"
			success message = "Parking Slot Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Slot_Number
			(
    			type = text
				displayname = "Slot Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Zone
			(
				type = picklist
				maxchar = 100
				values = {"Zone A","Zone B","Zone C"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Slot_Type
			(
				type = picklist
				displayname = "Slot Type"
				maxchar = 100
				values = {"Car","Bike","EV Charging"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Hourly_Rate
			(
				type = number
				displayname = "Hourly Rate"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Available","Occupied","Under Maintenance"}
				initial value = "Available"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Vehicle_Booking
		{
			displayname = "Vehicle Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Vehicle_Number
			(
    			type = text
				displayname = "Vehicle Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Owner_Name
			(
    			type = text
				displayname = "Owner Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Vehicle_Type
			(
				type = picklist
				displayname = "Vehicle Type"
				maxchar = 100
				values = {"Car","Bike","EV Charging"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Parking_Slot
			(
				type = picklist	
				displayname = "Parking Slot"
				values  = Parking_Slot.ID
    			displayformat = [Slot_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Entry_Time
			(
    			type = datetime
				displayname = "Entry Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Exit_Time
			(
    			type = datetime
				displayname = "Exit Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Duration_Hours
			(
				type = decimal
				displayname = "Duration Hours"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amount
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Booking_Status
			(
				type = picklist
				displayname = "Booking Status"
				maxchar = 100
				values = {"Parked","Exited"}
				initial value = "Parked"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Parking_Slots
		{
			displayName = "All Parking Slots"
			show all rows from Parking_Slot    
			(
				Slot_Number as "Slot Number"
				Zone
				Slot_Type as "Slot Type"
				Hourly_Rate as "Hourly Rate"
				Status
			)
		}
		default list Vehicle_Booking_Report
		{
			displayName = "Vehicle Booking Report"
			show all rows from Vehicle_Booking    
			(
				Vehicle_Number as "Vehicle Number"
				Owner_Name as "Owner Name"
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Vehicle_Type as "Vehicle Type"
				Parking_Slot as "Parking Slot"
				Entry_Time as "Entry Time"
				Exit_Time as "Exit Time"
				Duration_Hours as "Duration Hours"
				Amount
				Booking_Status as "Booking Status"
			)
			custom actions
			(
				"Checkout"
				(
	  			workflow = Checkout_Vehicle
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "Execute the Checkout action for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		}
		kanban Slot_Board
		{
			displayName = "Slot Board"
			show all rows from Parking_Slot    
			(
				Slot_Number as "Slot Number"
				Zone
				Slot_Type as "Slot Type"
				Hourly_Rate as "Hourly Rate"
				Status
			)
			options
			(
	 			display field = Status
				record count  = enable
	 		)
		}
		calendar Booking_Calendar
		{
			displayName = "Booking Calendar"
			show all rows from Vehicle_Booking    
			(
				Vehicle_Number as "Vehicle Number"
				Owner_Name as "Owner Name"
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Vehicle_Type as "Vehicle Type"
				Parking_Slot as "Parking Slot"
				Entry_Time as "Entry Time"
				Exit_Time as "Exit Time"
				Duration_Hours as "Duration Hours"
				Amount
				Booking_Status as "Booking Status"
			)
			options
			(
				display field = Vehicle_Number
				start date = Entry_Time
			)
		}
	}
