		 functions
		 {
			 Deluge
			 {
				 void checkoutVehicle(int bookingId)
                 {
                 	// One-click checkout: records exit time, calculates fee and releases the slot
                 	bk = Vehicle_Booking[ID == bookingId];
                 	if(bk.Booking_Status == "Exited")
                 	{
                 		return;
                 	}
                 	slot = Parking_Slot[ID == bk.Parking_Slot];
                 	exitTime = zoho.currenttime;
                 	diffMs = exitTime.toLong() - bk.Entry_Time.toLong();
                 	billHours = (diffMs / 3600000.0).ceil();
                 	if(billHours < 1)
                 	{
                 		billHours = 1;
                 	}
                 	bk.Exit_Time=exitTime;
                 	bk.Duration_Hours=(diffMs / 3600000.0).round(2);
                 	bk.Amount=billHours * slot.Hourly_Rate;
                 	bk.Booking_Status="Exited";
                 	slot.Status="Available";
                 }
			 }
		 }


		workflow
		{
		form
		{
			Check_Slot_Availability as "Check Slot Availability"
			{
				type =  form
				form = Vehicle_Booking

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Allow booking only when the selected slot is Available
										slot = Parking_Slot[ID == input.Parking_Slot];
										if(slot.Status != "Available")
										{
											alert "Slot " + slot.Slot_Number + " is " + slot.Status + ". Please choose an Available slot.";
											cancel submit;
										}
										// Vehicle type must match the slot type
										if(slot.Slot_Type != input.Vehicle_Type)
										{
											alert "Slot " + slot.Slot_Number + " is reserved for " + slot.Slot_Type + " vehicles.";
											cancel submit;
										}
										input.Booking_Status = "Parked";
						)
					}
				}

			}
			Mark_Slot_Occupied as "Mark Slot Occupied"
			{
				type =  form
				form = Vehicle_Booking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// After a vehicle is parked, mark the slot as Occupied
										slot = Parking_Slot[ID == input.Parking_Slot];
										slot.Status="Occupied";
										info "Slot " + slot.Slot_Number + " is now Occupied by " + input.Vehicle_Number;
						)
					}
				}

			}
			Calculate_Parking_Fee as "Calculate Parking Fee"
			{
				type =  form
				form = Vehicle_Booking

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// When Exit Time is entered, calculate duration and parking fee
										if(input.Exit_Time != null)
										{
											if(input.Exit_Time <= input.Entry_Time)
											{
												alert "Exit Time must be after Entry Time.";
												cancel submit;
											}
											slot = Parking_Slot[ID == input.Parking_Slot];
											diffMs = input.Exit_Time.toLong() - input.Entry_Time.toLong();
											hours = (diffMs / 3600000.0).round(2);
											billHours = (diffMs / 3600000.0).ceil();
											if(billHours < 1)
											{
												billHours = 1;
											}
											input.Duration_Hours = hours;
											input.Amount = billHours * slot.Hourly_Rate;
											input.Booking_Status = "Exited";
										}
						)
					}
				}

			}
			Release_Slot_on_Exit as "Release Slot on Exit"
			{
				type =  form
				form = Vehicle_Booking

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// When the vehicle exits, make the slot Available again
										if(input.Booking_Status == "Exited")
										{
											slot = Parking_Slot[ID == input.Parking_Slot];
											slot.Status="Available";
											info "Slot " + slot.Slot_Number + " released. Fee collected: Rs." + input.Amount;
										}
						)
					}
				}

			}
			Set_Entry_Time as "Set Entry Time"
			{
				type =  form
				form = Vehicle_Booking

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// New booking: entry time = now, exit details are filled later
										input.Entry_Time = zoho.currenttime;
										input.Booking_Status = "Parked";
										hide Exit_Time;
										hide Duration_Hours;
										hide Amount;
										disable Booking_Status;
						)
					}
				}

			}
		}






		functions
		{
			Checkout_Vehicle as "Checkout Vehicle"
			{
				type =  functions
				form = Vehicle_Booking
				execution type = for each record	
				on start
				{
					actions 
					{
						thisapp.checkoutVehicle(ID);
					}
				}
			}
		}
	}
